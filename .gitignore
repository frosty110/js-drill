# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Claude Code session/cache (skills/ is checked in; runtime files are not)
.claude/*
!.claude/skills/

# Node (if you ever add tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / secrets
.env
.env.local
.env.*.local

# Backups & cheatsheets that the app generates locally
js-drill-progress-*.json
js-drill-cheatsheet-*.md

# Editors
.vscode/
.idea/
*.swp
*.swo

# Temp
/tmp/
*.log

# Probe-only CDN shim, obsolete since tools/vendor-deps.js put the real bytes in
# vendor/. Kept ignored so an old working copy can't be committed by accident.
tools/cdp/vendor/
