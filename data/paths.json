    {
      "id": "prep-4day",
      "label": "4-Day Interview Cram",
      "icon": "⏱",
      "kind": "cram",
      "blurb": "Interview in 4 days. Day-by-day plan with mocks. Earlier-day lessons resurface as SR review on later days. After Day 4 → pure SR keeps everything alive.",
      "startIso": "2026-05-24",
      "sidebarButtons": [
        "today-btn", "mock-btn", "path-btn", "hide-mastered-btn",
        "review-btn", "weak-btn", "at-risk-btn", "resurrect-btn",
        "mechanics-btn", "export-btn",
        "cram-cheat-btn", "cram-glossary-btn", "cram-behavior-btn", "cram-shapes-btn",
        "cram-review-btn",
        "stats-btn", "streak-map-btn"
      ],
      "bigRocks": [
        { "rock": "Binary search", "detail": "Own this algorithm by Day 2. Know the invariant cold." },
        { "rock": "BFS vs DFS", "detail": "BFS for unweighted shortest path. DFS for connectedness, cycles, traversal." },
        { "rock": "JS sort gotcha", "detail": "`[10,2,5].sort()` returns `[10,2,5]`. Always use `(a,b)=>a-b` for numbers." },
        { "rock": "Substring vs subsequence", "detail": "Substring = contiguous. Subsequence = gappy. Memorize this." },
        { "rock": "Kadane's algorithm", "detail": "~15 min to learn forever. Reset running sum to 0 when it goes negative." }
      ],
      "days": [
        {
          "day": 1,
          "title": "Foundations & gap-fills",
          "date": "Sat, May 24",
          "iso": "2026-05-24",
          "blocks": [
            {
              "id": "d1m",
              "title": "Morning — Clear the 5 big rocks",
              "duration": "~2 hr",
              "tasks": [
                { "id": "d1m-1", "label": "Read the Glossary out loud, twice. Especially: monotonic, in/pre/post-order, substring vs subsequence.", "mins": 30 },
                { "id": "d1m-2", "label": "Write each of the 6 Must-Know Code Shapes on paper from memory. Compare to cheatsheet. Repeat anything you got wrong.", "mins": 30 },
                { "id": "d1m-3", "label": "JS sort gotcha — re-drill", "mins": 10, "lessonId": "sorting" },
                { "id": "d1m-3b", "label": "Big-O intuition — drill the log(n) = halving derivation BEFORE binary search re-read", "mins": 10, "lessonId": "s-bigo-intuition" },
                { "id": "d1m-4", "label": "Binary Search — re-read invariants carefully (with fresh log(n) context)", "mins": 15, "lessonId": "binary-search" },
                { "id": "d1m-5", "label": "BFS queue scaffold — drill", "mins": 10, "lessonId": "s-bfs-template" },
                { "id": "d1m-6", "label": "Pre/in/post-order traversal — say each out loud", "mins": 10, "lessonId": "s-tree-traversals" },
                { "id": "d1m-7", "label": "Kadane's algo — learn it now", "mins": 15, "lessonId": "p-max-subarray" },
                { "id": "d1m-8", "label": "Re-read your wrong answers in the diagnostic JSON; say 'ah' out loud for each.", "mins": 15 }
              ]
            },
            {
              "id": "d1a",
              "title": "Afternoon — Arrays & Hashing + Two Pointers",
              "duration": "~3 hr",
              "tasks": [
                { "id": "d1a-1", "label": "L1+L2+L3", "lessonId": "two-sum" },
                { "id": "d1a-2", "label": "L1+L2", "lessonId": "p-contains-dup" },
                { "id": "d1a-3", "label": "L1+L2", "lessonId": "p-anagrams" },
                { "id": "d1a-4", "label": "L1+L2", "lessonId": "p-valid-anagram" },
                { "id": "d1a-5", "label": "L1+L2", "lessonId": "p-encode-decode-strings" },
                { "id": "d1a-6", "label": "L1+L2", "lessonId": "p-longest-consecutive" },
                { "id": "d1a-7", "label": "L1+L2+L3", "lessonId": "valid-palindrome" },
                { "id": "d1a-8", "label": "L1+L2+L3", "lessonId": "p-3sum" },
                { "id": "d1a-9", "label": "L1+L2", "lessonId": "p-container" },
                { "id": "d1a-10", "label": "L1+L2", "lessonId": "p-trapping-rain" }
              ]
            },
            {
              "id": "d1e",
              "title": "Evening — Mock pressure (optional but recommended)",
              "duration": "~1–2 hr",
              "tasks": [
                { "id": "d1e-1", "label": "Open Mock Interview mode in the app. 30 min, 3 random problems from sections above. NO hints.", "mins": 30 },
                { "id": "d1e-2", "label": "Anything you got stuck on — note it; re-do the L3 tomorrow morning before Day 2 work.", "mins": 15 }
              ]
            }
          ],
          "checkpoints": [
            "I can write binary search from memory in <2 min with correct invariants.",
            "I can name when BFS vs DFS, and write the queue/stack scaffold for each.",
            "I no longer have to think about `(a,b) => a - b`.",
            "I know what Kadane's does in one sentence."
          ]
        },
