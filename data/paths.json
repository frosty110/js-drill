              "title": "Evening — Tree-shape drill",
              "duration": "~1.5 hr",
              "tasks": [
                { "id": "d2e-1", "label": "Write BFS level-order on paper 3× from memory", "mins": 15 },
                { "id": "d2e-2", "label": "Write DFS recursive in-order 3× from memory", "mins": 15 },
                { "id": "d2e-3", "label": "Write DFS recursive post-order (for tree height) 3× from memory", "mins": 15 },
                { "id": "d2e-4", "label": "Write DFS iterative pre-order with explicit stack 3× from memory", "mins": 15 },
                { "id": "d2e-5", "label": "Drill", "lessonId": "p-max-depth" },
                { "id": "d2e-6", "label": "Drill", "lessonId": "p-invert" },
